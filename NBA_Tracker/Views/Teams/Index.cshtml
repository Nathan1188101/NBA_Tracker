@model IEnumerable<NBA_Tracker.Models.Team>

@{
    ViewData["Title"] = "Teams";
}

<h1>Teams List</h1>
<!--I only want to show this message as it is only relevant to a user that can see the link, so if they're signed in they'll see this along with the create link-->
@if (User.Identity.IsAuthenticated){
<p>NOTE:<br /> 
   Functionality to create, delete, and edit is here if needed, but this isn't something that changes often.</p>
}
<p>
    @if (User.Identity.IsAuthenticated)
    {
        <a asp-action="Create">Create New (if needed)</a> 
    }
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.TeamName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.City)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Coach)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.TeamName)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.City)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Coach)
            </td>
         @if (User.Identity.IsAuthenticated)
           {
            <td>
                <a asp-action="Edit" asp-route-id="@item.TeamId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.TeamId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.TeamId">Delete (if needed)</a>
            </td>
            }
        </tr>
}
    </tbody>
</table>
