@model IEnumerable<NBA_Tracker.Models.GamePlayerStats>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Points)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Rebounds)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Assists)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Steals)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Blocks)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Game)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Player)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(modelItem => item.Points)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Rebounds)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Assists)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Steals)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Blocks)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Game.Location)
            </td>
            <td>
                @Html.DisplayFor(modelItem => item.Player.FirstName)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.StatId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.StatId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.StatId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
